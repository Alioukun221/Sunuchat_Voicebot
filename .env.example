# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer le .env.

# --- WhatsApp Cloud API (developers.facebook.com → ton app → WhatsApp) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PIN=
GRAPH_API_VERSION=v25.0

# --- Gemini (aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# Avec la facturation activée, remettre gemini-flash-latest (meilleures traductions).
AGENT_MODEL=gemini-flash-lite-latest
FAST_MODEL=gemini-flash-lite-latest
# Traduction wolof / pulaar (vide : FAST_MODEL).
TRANSLATION_MODEL=

# --- Google Maps (facultatif) : MCP Grounding Lite pour les postes de santé ---
GOOGLE_MAPS_API_KEY=

# --- Voix wolof / pulaar (API Kiriku) ---
SPEECH_API_BASE_URL=https://14hyb7tjwzuh9q-8000.proxy.runpod.net/v1
SPEECH_API_KEY=
DEFAULT_LANGUAGE=wolof

# --- RAG : modèle d'embeddings local (téléchargé une fois, ~2,3 Go) et ChromaDB ---
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=mps

# --- Corpus des sources officielles (pour construire l'index RAG) ---
# Par défaut data/kb (corpus nettoyé par scripts/nettoyer_kb.py).
# KB_DIR=data/kb

# --- Modèles de messages Meta (rappels de vaccins, alertes d'hivernage) : voir README ---
TEMPLATE_RAPPEL_VACCIN=
TEMPLATE_ALERTE_SAISON=
TEMPLATE_LANGUAGE=fr
